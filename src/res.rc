// wifiForce application resource script (icon, manifest, version information).
//
// Kept free of system headers so that both the MSVC resource compiler and
// MinGW-w64 windres can process it without extra include paths.

// The version numbers, written by tools\build-files.ps1 from version.txt (the
// build directory is on the resource compiler's include path).
#include "version_generated.h"

// Values that normally come from winver.h / windows.h, defined here so that the
// script is self-contained.  If the resource compiler already knows them the
// guards below keep their definitions.
//
// VS_VERSION_INFO matters in particular: without it the version block is stored
// under the *name* "VS_VERSION_INFO" instead of resource id 1, and then neither
// the file's Details tab nor GetFileVersionInfo() finds it.
#ifndef VS_VERSION_INFO
#define VS_VERSION_INFO 1
#endif
#ifndef VS_FFI_FILEFLAGSMASK
#define VS_FFI_FILEFLAGSMASK 0x0000003FL
#endif
#ifndef VOS_NT_WINDOWS32
#define VOS_NT_WINDOWS32 0x00040000L
#endif
#ifndef VFT_APP
#define VFT_APP 0x00000001L
#endif

// The application icon.  Explorer, the taskbar, Alt+Tab, the title bar and the
// running program's window all take it from this group.  Generated by
// tools\make-icon.ps1 (Wi-Fi in a shield, on JustViewMD's blue tile).
1 ICON "app.ico"

// The manifest: requireAdministrator plus the Common Controls 6 dependency.
1 24 "app.manifest"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION     WIFIFFORCE_VERSION_COMMA
 PRODUCTVERSION  WIFIFFORCE_VERSION_COMMA
 FILEFLAGSMASK   VS_FFI_FILEFLAGSMASK
 FILEFLAGS       0x0L
 FILEOS          VOS_NT_WINDOWS32
 FILETYPE        VFT_APP
 FILESUBTYPE     0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName",      "finnuen"
            VALUE "FileDescription",  "wifiForce - keeps Wi-Fi connected while Ethernet is plugged in"
            VALUE "FileVersion",      WIFIFFORCE_VERSION_DOTTED
            VALUE "InternalName",     "wifiForce"
            VALUE "LegalCopyright",   "Copyright 2026 finnuen. Apache-2.0"
            VALUE "OriginalFilename", WIFIFFORCE_VERSION_BINARY
            VALUE "ProductName",      "wifiForce"
            VALUE "ProductVersion",   WIFIFFORCE_VERSION_DOTTED
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
